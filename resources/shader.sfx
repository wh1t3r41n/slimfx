// shader.sfx -- SlimFX Shader Language
// Compiled to GLSL 330 Core. C-like, no preprocessor hell.
//
// 1. One file can contain multiple stages: @vertex, @fragment, @compute.
// 2. Uniforms are declared like C globals, with a binding slot.
// 3. Inputs/outputs are explicit structs passed to @entry.
// 4. Built-ins: mat4 perspective(), mat4 look_at(), vec3 normalize(), ...

#version 330 core

// ---- Uniforms -------------------------------------------------------------
// layout(binding=N) is auto-assigned unless explicit.
uniform mat4 u_model;
uniform mat4 u_view;
uniform mat4 u_proj;
uniform mat3 u_normal_mat;
uniform float u_time = 0.0;
uniform vec3  u_light_dir = vec3(0.0, -1.0, 0.0);

uniform sampler2D u_albedo;
uniform sampler2D u_normal;

// ---- IO structs -----------------------------------------------------------
struct VsIn {
    vec3 position;
    vec3 normal;
    vec2 uv;
    vec4 color;
};

struct VsOut {
    vec4 clip_pos;
    vec3 world_pos;
    vec3 world_normal;
    vec2 uv;
    vec4 color;
};

struct FsOut {
    vec4 color;
};

// ---- Helpers --------------------------------------------------------------
const float PI = 3.14159265359;

mat3 make_normal_mat(mat4 m) {
    return mat3(transpose(inverse(m)));
}

// ---- Vertex stage ---------------------------------------------------------
@vertex
VsOut vs_main(VsIn in) {
    VsOut o;
    o.clip_pos     = u_proj * u_view * u_model * vec4(in.position, 1.0);
    o.world_pos    = (u_model * vec4(in.position, 1.0)).xyz;
    o.world_normal = normalize(u_normal_mat * in.normal);
    o.uv           = in.uv;
    o.color        = in.color;
    return o;
}

// ---- Fragment stage -------------------------------------------------------
@fragment
FsOut fs_main(VsOut in) {
    vec3 albedo = texture(u_albedo, in.uv).rgb;
    vec3 n      = normalize(in.world_normal);
    float ndotl = max(dot(n, -u_light_dir), 0.0);
    vec3 lit    = albedo * (0.2 + 0.8 * ndotl);
    FsOut o;
    o.color = vec4(lit * in.color.rgb, 1.0);
    return o;
}